# Analyst layer (Layer 8) configuration.
#
# With NONE of this set, the service still runs, still explains every alert,
# and opens no outbound connection at all. Setting ANALYST_GEMINI_API_KEY is
# what turns generation on - and it is the only thing that creates egress.

# Where the read-only alert API lives.
ANALYST_BACKEND_URL=http://127.0.0.1:8000

# auto | gemini | template
#   auto     -> gemini when a key is present, template otherwise (default)
#   template -> never generate, never leave the machine
ANALYST_PROVIDER=auto

# Your Gemini API key. Leave blank to run fully local.
ANALYST_GEMINI_API_KEY=

# Set this to a model your key can actually reach. Reported by
# GET /api/v1/analyst/health so a wrong value shows up before the demo.
ANALYST_GEMINI_MODEL=gemini-2.5-flash-lite

ANALYST_HOST=127.0.0.1
ANALYST_PORT=8100
ANALYST_LOG_LEVEL=INFO
