# Copy to .env and edit. Every value here has a working default - the service
# runs with no .env at all, on the in-memory store.

# --- service ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- storage ---
# "memory" needs nothing and loses history on restart. It is the demo-day
# fallback: if the database is unreachable on stage, switch to it and every
# screen keeps working.
STORAGE_BACKEND=memory

# For Supabase, take the connection string from:
#   Supabase dashboard > Project Settings > Database > Connection string > URI
# Use the *pooler* URI (port 6543) rather than the direct one (5432).
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Or let the URL be derived from these. SUPABASE_REGION is NOT guessable - it is
# whatever region the project was created in - so read it off the pooler
# hostname in the dashboard. The password is percent-encoded for you, so one
# containing @ or / needs no escaping here.
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_REGION=ap-south-1

# Batched writes. One insert per alert becomes the bottleneck during a flood,
# which is exactly when you least want one.
DB_BATCH_SIZE=200
DB_BATCH_INTERVAL_S=0.5
DB_QUEUE_MAX=50000

# --- fusion ---
# Repeat findings for the same entity + class + detector inside this window fold
# into one alert with an occurrence count.
DEDUP_WINDOW_S=300
# Alerts touching the same host within this window join one incident.
CORRELATION_WINDOW_S=1800
# Distinct kill-chain stages before the sequence itself escalates severity.
CORRELATION_ESCALATE_STAGES=2

# --- live path ---
# Per-connection outbound queue. When a dashboard falls behind we drop the
# oldest frames and report the count, rather than letting one slow browser
# apply backpressure to the detection pipeline.
WS_QUEUE_MAX=1000
WS_SNAPSHOT_SIZE=100
METRICS_INTERVAL_S=1.0

# --- telemetry ---
# Traffic-rate reports older than this are shown as unavailable rather than as
# a stale number presented as current.
TELEMETRY_STALE_AFTER_S=5
DETECTOR_STALE_AFTER_S=120
